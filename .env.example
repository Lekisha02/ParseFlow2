# Server-side only. Never sent to the browser. ParseFlow runs fully offline without any of these keys:
# text layer + tables + equations (digital PDFs) + Tesseract OCR. Without a vision key, handwriting,
# hand-drawn diagrams and charts are preserved and flagged, not read.
VISION_API_KEY=
# Pick ONE provider:
#   VISION_PROVIDER=anthropic   -> key from console.anthropic.com   (default model claude-sonnet-5-5)
#   VISION_PROVIDER=gemini      -> key from aistudio.google.com     (default model gemini-2.5-flash)
VISION_PROVIDER=anthropic
VISION_MODEL=
MAX_VISION_REGIONS=12
MAX_PAGES=1000
MAX_UPLOAD_MB=300

# OCR (Tesseract)
OCR_LANG=eng
OCR_TIMEOUT=60
OCR_MAX_ATTEMPTS=2

# Exclude confidently detected running headers/footers/page numbers from the Markdown (kept in JSON)
PARSEFLOW_REMOVE_FURNITURE=1

# Optional local formula recognizer for SCANNED equations: none | pix2tex | rapid_latex_ocr | command
# Weights are never downloaded automatically; put them in PARSEFLOW_MATH_MODEL_DIR.
PARSEFLOW_MATH_RECOGNIZER=none
PARSEFLOW_MATH_MODEL_DIR=
PARSEFLOW_MATH_CMD=

# API storage / housekeeping
PARSEFLOW_JOB_TTL_HOURS=24
PARSEFLOW_WORKERS=2
